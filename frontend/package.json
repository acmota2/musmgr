{
  "name": "musmgr-frontend",
  "packageManager": "pnpm@11.0.9",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "private": true,
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "build": "vite build",
    "build:admin": "VITE_FRONTEND_BUILD_MODE=admin vite build",
    "build:public": "VITE_FRONTEND_BUILD_MODE=public vite build",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "dev:admin": "VITE_FRONTEND_BUILD_MODE=admin vite dev --port 5173",
    "dev:public": "VITE_FRONTEND_BUILD_MODE=public vite dev --port 5174",
    "prepare": "svelte-kit sync || echo ''",
    "preview:admin": "VITE_FRONTEND_BUILD_MODE=admin vite preview --port 5173",
    "preview:public": "VITE_FRONTEND_BUILD_MODE=public vite preview --port 5174",
    "test": "npm run test:e2e && npm run test:unit -- --run",
    "test:e2e": "playwright test",
    "test:unit": "vitest"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@sveltejs/adapter-node": "^5.5.4",
    "@sveltejs/kit": "^2.59.1",
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "@types/node": "^25.6.2",
    "svelte": "^5.55.5",
    "svelte-check": "^4.4.8",
    "typescript": "^6.0.3",
    "vite": "^8.0.11",
    "vitest": "^4.1.5"
  }
}
