{
  "name": "musmgr-frontend",
  "packageManager": "pnpm@12.9.0",
  "private": true,
  "type": "module",
  "version": "0.7.1",
  "scripts": {
    "build": "vite build",
    "build:admin": "VITE_FRONTEND_BUILD_MODE=admin vite build",
    "build:public": "VITE_FRONTEND_BUILD_MODE=public vite build",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "dev:admin": "VITE_FRONTEND_BUILD_MODE=admin vite dev --port 5173",
    "dev:public": "VITE_FRONTEND_BUILD_MODE=public vite dev --port 5174",
    "prepare": "svelte-kit sync || echo ''",
    "preview:admin": "VITE_FRONTEND_BUILD_MODE=admin vite preview --port 5173",
    "preview:public": "VITE_FRONTEND_BUILD_MODE=public vite preview --port 5174",
    "test": "npm run test:e2e && npm run test:unit -- --run",
    "test:e2e": "playwright test",
    "test:unit": "vitest"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@sveltejs/adapter-node": "^5.5.8",
    "@sveltejs/kit": "^2.70.4",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/node": "^26.6.6",
    "svelte": "^5.59.1",
    "svelte-check": "^4.7.8",
    "typescript": "^6.0.3",
    "vite": "^8.0.13",
    "vitest": "^4.1.6"
  }
}
